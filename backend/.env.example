# --- Supabase Postgres (Prisma) ---
# Project Settings > Database > Connection string > "Transaction" pooler (for serverless-friendly pooling)
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# "Session" pooler / direct connection, used by Prisma Migrate which needs a non-pooled connection
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth / API ---
# Project Settings > API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # server-side only, never expose to the app

# --- AI (Voice-to-data Daily Entry) ---
# Free-tier key from https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"
# Optional override; defaults to gemini-3.6-flash if unset.
GEMINI_MODEL="gemini-3.6-flash"

# --- Server ---
PORT=4000
CORS_ORIGIN="*"
